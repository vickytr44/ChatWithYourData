schema {
  query: Query
  mutation: Mutation
}

type Query {
  products(
    "Returns the first _n_ elements from the list."
    first: Int
    "Returns the elements in the list that come after the specified cursor."
    after: String
    "Returns the last _n_ elements from the list."
    last: Int
    "Returns the elements in the list that come before the specified cursor."
    before: String
    where: ProductFilterInput @cost(weight: "10")
    order: [ProductSortInput!] @cost(weight: "10")
  ): ProductsConnection
    @listSize(
      assumedSize: 50
      slicingArguments: ["first", "last"]
      slicingArgumentDefaultValue: 10
      sizedFields: ["edges", "nodes"]
      requireOneSlicingArgument: false
    )
    @cost(weight: "10")
  productById(id: UUID!): Product @cost(weight: "10")
  categories(
    "Returns the first _n_ elements from the list."
    first: Int
    "Returns the elements in the list that come after the specified cursor."
    after: String
    "Returns the last _n_ elements from the list."
    last: Int
    "Returns the elements in the list that come before the specified cursor."
    before: String
    where: CategoryFilterInput @cost(weight: "10")
    order: [CategorySortInput!] @cost(weight: "10")
  ): CategoriesConnection
    @listSize(
      assumedSize: 50
      slicingArguments: ["first", "last"]
      slicingArgumentDefaultValue: 10
      sizedFields: ["edges", "nodes"]
      requireOneSlicingArgument: false
    )
    @cost(weight: "10")
  warehouses(
    "Returns the first _n_ elements from the list."
    first: Int
    "Returns the elements in the list that come after the specified cursor."
    after: String
    "Returns the last _n_ elements from the list."
    last: Int
    "Returns the elements in the list that come before the specified cursor."
    before: String
    where: WarehouseFilterInput @cost(weight: "10")
    order: [WarehouseSortInput!] @cost(weight: "10")
  ): WarehousesConnection
    @listSize(
      assumedSize: 50
      slicingArguments: ["first", "last"]
      slicingArgumentDefaultValue: 10
      sizedFields: ["edges", "nodes"]
      requireOneSlicingArgument: false
    )
    @cost(weight: "10")
  stockItems(
    "Returns the first _n_ elements from the list."
    first: Int
    "Returns the elements in the list that come after the specified cursor."
    after: String
    "Returns the last _n_ elements from the list."
    last: Int
    "Returns the elements in the list that come before the specified cursor."
    before: String
    where: StockItemFilterInput @cost(weight: "10")
    order: [StockItemSortInput!] @cost(weight: "10")
  ): StockItemsConnection
    @listSize(
      assumedSize: 50
      slicingArguments: ["first", "last"]
      slicingArgumentDefaultValue: 10
      sizedFields: ["edges", "nodes"]
      requireOneSlicingArgument: false
    )
    @cost(weight: "10")
  lowStockAlerts(where: StockItemFilterInput @cost(weight: "10")): [StockItem!]!
    @cost(weight: "10")
}

type Mutation {
  createProduct(input: CreateProductInput!): MutationPayloadOfProductDto!
    @cost(weight: "10")
  adjustStock(input: AdjustStockInput!): MutationPayloadOfStockItemDto!
    @cost(weight: "10")
}

"A connection to a list of items."
type CategoriesConnection {
  "Information to aid in pagination."
  pageInfo: PageInfo!
  "A list of edges."
  edges: [CategoriesEdge!]
  "A flattened list of the nodes."
  nodes: [Category!]
}

"An edge in a connection."
type CategoriesEdge {
  "A cursor for use in pagination."
  cursor: String!
  "The item at the end of the edge."
  node: Category!
}

type Category {
  name: String!
  description: String
  parentCategoryId: UUID
  parentCategory: Category
  subCategories: [Category!]!
  products: [Product!]!
  id: UUID!
  createdAtUtc: DateTime!
  updatedAtUtc: DateTime
}

type MutationPayloadOfProductDto {
  success: Boolean!
  data: ProductDto
  error: String
}

type MutationPayloadOfStockItemDto {
  success: Boolean!
  data: StockItemDto
  error: String
}

"Information about pagination in a connection."
type PageInfo {
  "Indicates whether more edges exist following the set defined by the clients arguments."
  hasNextPage: Boolean!
  "Indicates whether more edges exist prior the set defined by the clients arguments."
  hasPreviousPage: Boolean!
  "When paginating backwards, the cursor to continue."
  startCursor: String
  "When paginating forwards, the cursor to continue."
  endCursor: String
}

"Represents a product within the inventory catalog."
type Product {
  "The category the product belongs to (resolved via DataLoader)."
  category: Category @cost(weight: "10")
  sku: String!
  name: String!
  description: String!
  unitPrice: Decimal!
  unitOfMeasure: String!
  isActive: Boolean!
  categoryId: UUID!
  stockItems: [StockItem!]!
  stockAdjustments: [StockAdjustment!]!
  id: UUID!
  createdAtUtc: DateTime!
  updatedAtUtc: DateTime
}

type ProductDto {
  id: UUID!
  sku: String!
  name: String!
  description: String!
  unitPrice: Decimal!
  unitOfMeasure: String!
  isActive: Boolean!
  categoryId: UUID!
  createdAtUtc: DateTime!
}

"A connection to a list of items."
type ProductsConnection {
  "Information to aid in pagination."
  pageInfo: PageInfo!
  "A list of edges."
  edges: [ProductsEdge!]
  "A flattened list of the nodes."
  nodes: [Product!]
}

"An edge in a connection."
type ProductsEdge {
  "A cursor for use in pagination."
  cursor: String!
  "The item at the end of the edge."
  node: Product!
}

type StockAdjustment {
  productId: UUID!
  warehouseId: UUID!
  quantityDelta: Int!
  reason: AdjustmentReason!
  notes: String!
  adjustedAtUtc: DateTime!
  product: Product
  warehouse: Warehouse
  id: UUID!
  createdAtUtc: DateTime!
  updatedAtUtc: DateTime
}

"Represents stock level for a product in a warehouse."
type StockItem {
  "The product associated with this stock item (resolved via DataLoader)."
  product: Product @cost(weight: "10")
  "The warehouse storing this stock item (resolved via DataLoader)."
  warehouse: Warehouse @cost(weight: "10")
  productId: UUID!
  warehouseId: UUID!
  quantityOnHand: Int!
  quantityReserved: Int!
  reorderPoint: Int!
  id: UUID!
  createdAtUtc: DateTime!
  updatedAtUtc: DateTime
}

type StockItemDto {
  id: UUID!
  productId: UUID!
  warehouseId: UUID!
  quantityOnHand: Int!
  quantityReserved: Int!
  reorderPoint: Int!
}

"A connection to a list of items."
type StockItemsConnection {
  "Information to aid in pagination."
  pageInfo: PageInfo!
  "A list of edges."
  edges: [StockItemsEdge!]
  "A flattened list of the nodes."
  nodes: [StockItem!]
}

"An edge in a connection."
type StockItemsEdge {
  "A cursor for use in pagination."
  cursor: String!
  "The item at the end of the edge."
  node: StockItem!
}

type Warehouse {
  code: String!
  name: String!
  locationAddress: String!
  isActive: Boolean!
  stockItems: [StockItem!]!
  id: UUID!
  createdAtUtc: DateTime!
  updatedAtUtc: DateTime
}

"A connection to a list of items."
type WarehousesConnection {
  "Information to aid in pagination."
  pageInfo: PageInfo!
  "A list of edges."
  edges: [WarehousesEdge!]
  "A flattened list of the nodes."
  nodes: [Warehouse!]
}

"An edge in a connection."
type WarehousesEdge {
  "A cursor for use in pagination."
  cursor: String!
  "The item at the end of the edge."
  node: Warehouse!
}

input AdjustmentReasonOperationFilterInput {
  eq: AdjustmentReason @cost(weight: "10")
  neq: AdjustmentReason @cost(weight: "10")
  in: [AdjustmentReason!] @cost(weight: "10")
  nin: [AdjustmentReason!] @cost(weight: "10")
}

input AdjustStockInput {
  productId: UUID!
  warehouseId: UUID!
  quantityDelta: Int!
  reason: AdjustmentReason!
  notes: String!
}

input BooleanOperationFilterInput {
  eq: Boolean @cost(weight: "10")
  neq: Boolean @cost(weight: "10")
}

input CategoryFilterInput {
  and: [CategoryFilterInput!]
  or: [CategoryFilterInput!]
  name: StringOperationFilterInput
  description: StringOperationFilterInput
  parentCategoryId: UuidOperationFilterInput
  parentCategory: CategoryFilterInput
  subCategories: ListFilterInputTypeOfCategoryFilterInput
  products: ListFilterInputTypeOfProductFilterInput
  id: UuidOperationFilterInput
  createdAtUtc: DateTimeOperationFilterInput
  updatedAtUtc: DateTimeOperationFilterInput
}

input CategorySortInput {
  name: SortEnumType @cost(weight: "10")
  description: SortEnumType @cost(weight: "10")
  parentCategoryId: SortEnumType @cost(weight: "10")
  parentCategory: CategorySortInput @cost(weight: "10")
  id: SortEnumType @cost(weight: "10")
  createdAtUtc: SortEnumType @cost(weight: "10")
  updatedAtUtc: SortEnumType @cost(weight: "10")
}

input CreateProductInput {
  sku: String!
  name: String!
  description: String!
  unitPrice: Decimal!
  unitOfMeasure: String!
  categoryId: UUID!
}

input DateTimeOperationFilterInput {
  eq: DateTime @cost(weight: "10")
  neq: DateTime @cost(weight: "10")
  in: [DateTime] @cost(weight: "10")
  nin: [DateTime] @cost(weight: "10")
  gt: DateTime @cost(weight: "10")
  ngt: DateTime @cost(weight: "10")
  gte: DateTime @cost(weight: "10")
  ngte: DateTime @cost(weight: "10")
  lt: DateTime @cost(weight: "10")
  nlt: DateTime @cost(weight: "10")
  lte: DateTime @cost(weight: "10")
  nlte: DateTime @cost(weight: "10")
}

input DecimalOperationFilterInput {
  eq: Decimal @cost(weight: "10")
  neq: Decimal @cost(weight: "10")
  in: [Decimal] @cost(weight: "10")
  nin: [Decimal] @cost(weight: "10")
  gt: Decimal @cost(weight: "10")
  ngt: Decimal @cost(weight: "10")
  gte: Decimal @cost(weight: "10")
  ngte: Decimal @cost(weight: "10")
  lt: Decimal @cost(weight: "10")
  nlt: Decimal @cost(weight: "10")
  lte: Decimal @cost(weight: "10")
  nlte: Decimal @cost(weight: "10")
}

input IntOperationFilterInput {
  eq: Int @cost(weight: "10")
  neq: Int @cost(weight: "10")
  in: [Int] @cost(weight: "10")
  nin: [Int] @cost(weight: "10")
  gt: Int @cost(weight: "10")
  ngt: Int @cost(weight: "10")
  gte: Int @cost(weight: "10")
  ngte: Int @cost(weight: "10")
  lt: Int @cost(weight: "10")
  nlt: Int @cost(weight: "10")
  lte: Int @cost(weight: "10")
  nlte: Int @cost(weight: "10")
}

input ListFilterInputTypeOfCategoryFilterInput {
  all: CategoryFilterInput @cost(weight: "10")
  none: CategoryFilterInput @cost(weight: "10")
  some: CategoryFilterInput @cost(weight: "10")
  any: Boolean @cost(weight: "10")
}

input ListFilterInputTypeOfProductFilterInput {
  all: ProductFilterInput @cost(weight: "10")
  none: ProductFilterInput @cost(weight: "10")
  some: ProductFilterInput @cost(weight: "10")
  any: Boolean @cost(weight: "10")
}

input ListFilterInputTypeOfStockAdjustmentFilterInput {
  all: StockAdjustmentFilterInput @cost(weight: "10")
  none: StockAdjustmentFilterInput @cost(weight: "10")
  some: StockAdjustmentFilterInput @cost(weight: "10")
  any: Boolean @cost(weight: "10")
}

input ListFilterInputTypeOfStockItemFilterInput {
  all: StockItemFilterInput @cost(weight: "10")
  none: StockItemFilterInput @cost(weight: "10")
  some: StockItemFilterInput @cost(weight: "10")
  any: Boolean @cost(weight: "10")
}

input ProductFilterInput {
  and: [ProductFilterInput!]
  or: [ProductFilterInput!]
  sku: StringOperationFilterInput
  name: StringOperationFilterInput
  description: StringOperationFilterInput
  unitPrice: DecimalOperationFilterInput
  unitOfMeasure: StringOperationFilterInput
  isActive: BooleanOperationFilterInput
  categoryId: UuidOperationFilterInput
  category: CategoryFilterInput
  stockItems: ListFilterInputTypeOfStockItemFilterInput
  stockAdjustments: ListFilterInputTypeOfStockAdjustmentFilterInput
  id: UuidOperationFilterInput
  createdAtUtc: DateTimeOperationFilterInput
  updatedAtUtc: DateTimeOperationFilterInput
}

input ProductSortInput {
  sku: SortEnumType @cost(weight: "10")
  name: SortEnumType @cost(weight: "10")
  description: SortEnumType @cost(weight: "10")
  unitPrice: SortEnumType @cost(weight: "10")
  unitOfMeasure: SortEnumType @cost(weight: "10")
  isActive: SortEnumType @cost(weight: "10")
  categoryId: SortEnumType @cost(weight: "10")
  category: CategorySortInput @cost(weight: "10")
  id: SortEnumType @cost(weight: "10")
  createdAtUtc: SortEnumType @cost(weight: "10")
  updatedAtUtc: SortEnumType @cost(weight: "10")
}

input StockAdjustmentFilterInput {
  and: [StockAdjustmentFilterInput!]
  or: [StockAdjustmentFilterInput!]
  productId: UuidOperationFilterInput
  warehouseId: UuidOperationFilterInput
  quantityDelta: IntOperationFilterInput
  reason: AdjustmentReasonOperationFilterInput
  notes: StringOperationFilterInput
  adjustedAtUtc: DateTimeOperationFilterInput
  product: ProductFilterInput
  warehouse: WarehouseFilterInput
  id: UuidOperationFilterInput
  createdAtUtc: DateTimeOperationFilterInput
  updatedAtUtc: DateTimeOperationFilterInput
}

input StockItemFilterInput {
  and: [StockItemFilterInput!]
  or: [StockItemFilterInput!]
  productId: UuidOperationFilterInput
  warehouseId: UuidOperationFilterInput
  quantityOnHand: IntOperationFilterInput
  quantityReserved: IntOperationFilterInput
  reorderPoint: IntOperationFilterInput
  product: ProductFilterInput
  warehouse: WarehouseFilterInput
  id: UuidOperationFilterInput
  createdAtUtc: DateTimeOperationFilterInput
  updatedAtUtc: DateTimeOperationFilterInput
}

input StockItemSortInput {
  productId: SortEnumType @cost(weight: "10")
  warehouseId: SortEnumType @cost(weight: "10")
  quantityOnHand: SortEnumType @cost(weight: "10")
  quantityReserved: SortEnumType @cost(weight: "10")
  reorderPoint: SortEnumType @cost(weight: "10")
  product: ProductSortInput @cost(weight: "10")
  warehouse: WarehouseSortInput @cost(weight: "10")
  id: SortEnumType @cost(weight: "10")
  createdAtUtc: SortEnumType @cost(weight: "10")
  updatedAtUtc: SortEnumType @cost(weight: "10")
}

input StringOperationFilterInput {
  and: [StringOperationFilterInput!]
  or: [StringOperationFilterInput!]
  eq: String @cost(weight: "10")
  neq: String @cost(weight: "10")
  contains: String @cost(weight: "20")
  ncontains: String @cost(weight: "20")
  in: [String] @cost(weight: "10")
  nin: [String] @cost(weight: "10")
  startsWith: String @cost(weight: "20")
  nstartsWith: String @cost(weight: "20")
  endsWith: String @cost(weight: "20")
  nendsWith: String @cost(weight: "20")
}

input UuidOperationFilterInput {
  eq: UUID @cost(weight: "10")
  neq: UUID @cost(weight: "10")
  in: [UUID] @cost(weight: "10")
  nin: [UUID] @cost(weight: "10")
  gt: UUID @cost(weight: "10")
  ngt: UUID @cost(weight: "10")
  gte: UUID @cost(weight: "10")
  ngte: UUID @cost(weight: "10")
  lt: UUID @cost(weight: "10")
  nlt: UUID @cost(weight: "10")
  lte: UUID @cost(weight: "10")
  nlte: UUID @cost(weight: "10")
}

input WarehouseFilterInput {
  and: [WarehouseFilterInput!]
  or: [WarehouseFilterInput!]
  code: StringOperationFilterInput
  name: StringOperationFilterInput
  locationAddress: StringOperationFilterInput
  isActive: BooleanOperationFilterInput
  stockItems: ListFilterInputTypeOfStockItemFilterInput
  id: UuidOperationFilterInput
  createdAtUtc: DateTimeOperationFilterInput
  updatedAtUtc: DateTimeOperationFilterInput
}

input WarehouseSortInput {
  code: SortEnumType @cost(weight: "10")
  name: SortEnumType @cost(weight: "10")
  locationAddress: SortEnumType @cost(weight: "10")
  isActive: SortEnumType @cost(weight: "10")
  id: SortEnumType @cost(weight: "10")
  createdAtUtc: SortEnumType @cost(weight: "10")
  updatedAtUtc: SortEnumType @cost(weight: "10")
}

enum AdjustmentReason {
  CYCLE_COUNT
  DAMAGE
  LOSS
  RESTOCK
  RETURN
  TRANSFER
}

enum SortEnumType {
  ASC
  DESC
}

"The `DateTime` scalar type represents a date and time with time zone offset information."
scalar DateTime
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/date-time.html")

"The `Decimal` scalar type represents a decimal floating-point number with high precision."
scalar Decimal
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/decimal.html")

"The `UUID` scalar type represents a Universally Unique Identifier (UUID) as defined by RFC 9562."
scalar UUID
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/uuid.html")

"The purpose of the `cost` directive is to define a `weight` for GraphQL types, fields, and arguments. Static analysis can use these weights when calculating the overall cost of a query or response."
directive @cost(
  "The `weight` argument defines what value to add to the overall cost for every appearance, or possible appearance, of a type, field, argument, etc."
  weight: String!
) on
  | SCALAR
  | OBJECT
  | FIELD_DEFINITION
  | ARGUMENT_DEFINITION
  | ENUM
  | INPUT_FIELD_DEFINITION

"The purpose of the `@listSize` directive is to either inform the static analysis about the size of returned lists (if that information is statically available), or to point the analysis to where to find that information."
directive @listSize(
  "The `assumedSize` argument can be used to statically define the maximum length of a list returned by a field."
  assumedSize: Int
  "The `slicingArguments` argument can be used to define which of the field's arguments with numeric type are slicing arguments, so that their value determines the size of the list returned by that field. It may specify a list of multiple slicing arguments."
  slicingArguments: [String!]
  "The `slicingArgumentDefaultValue` argument can be used to define a default value for a slicing argument, which is used if the argument is not present in a query."
  slicingArgumentDefaultValue: Int
  "The `sizedFields` argument can be used to define that the value of the `assumedSize` argument or of a slicing argument does not affect the size of a list returned by a field itself, but that of a list returned by one of its sub-fields."
  sizedFields: [String!]
  "The `requireOneSlicingArgument` argument can be used to inform the static analysis that it should expect that exactly one of the defined slicing arguments is present in a query. If that is not the case (i.e., if none or multiple slicing arguments are present), the static analysis may throw an error."
  requireOneSlicingArgument: Boolean = true
) on FIELD_DEFINITION