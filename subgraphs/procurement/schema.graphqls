schema {
  query: Query
  mutation: Mutation
}

type Query {
  vendors(
    "Returns the first _n_ elements from the list."
    first: Int
    "Returns the elements in the list that come after the specified cursor."
    after: String
    "Returns the last _n_ elements from the list."
    last: Int
    "Returns the elements in the list that come before the specified cursor."
    before: String
    where: VendorFilterInput @cost(weight: "10")
    order: [VendorSortInput!] @cost(weight: "10")
  ): VendorsConnection
    @listSize(
      assumedSize: 50
      slicingArguments: ["first", "last"]
      slicingArgumentDefaultValue: 10
      sizedFields: ["edges", "nodes"]
      requireOneSlicingArgument: false
    )
    @cost(weight: "10")
  vendorById(id: UUID!): Vendor @lookup @cost(weight: "10")
  purchaseOrders(
    "Returns the first _n_ elements from the list."
    first: Int
    "Returns the elements in the list that come after the specified cursor."
    after: String
    "Returns the last _n_ elements from the list."
    last: Int
    "Returns the elements in the list that come before the specified cursor."
    before: String
    where: PurchaseOrderFilterInput @cost(weight: "10")
    order: [PurchaseOrderSortInput!] @cost(weight: "10")
  ): PurchaseOrdersConnection
    @listSize(
      assumedSize: 50
      slicingArguments: ["first", "last"]
      slicingArgumentDefaultValue: 10
      sizedFields: ["edges", "nodes"]
      requireOneSlicingArgument: false
    )
    @cost(weight: "10")
  goodsReceipts(
    "Returns the first _n_ elements from the list."
    first: Int
    "Returns the elements in the list that come after the specified cursor."
    after: String
    "Returns the last _n_ elements from the list."
    last: Int
    "Returns the elements in the list that come before the specified cursor."
    before: String
    where: GoodsReceiptFilterInput @cost(weight: "10")
    order: [GoodsReceiptSortInput!] @cost(weight: "10")
  ): GoodsReceiptsConnection
    @listSize(
      assumedSize: 50
      slicingArguments: ["first", "last"]
      slicingArgumentDefaultValue: 10
      sizedFields: ["edges", "nodes"]
      requireOneSlicingArgument: false
    )
    @cost(weight: "10")
}

type Mutation {
  createVendor(input: CreateVendorInput!): ProcurementMutationPayloadOfVendorDto!
    @cost(weight: "10")
  createPurchaseOrder(input: CreatePurchaseOrderInput!): ProcurementMutationPayloadOfPurchaseOrderDto!
    @cost(weight: "10")
}

type GoodsReceipt {
  purchaseOrderId: UUID!
  receiptNumber: String!
  receivedDateUtc: DateTime!
  receivedBy: String!
  notes: String!
  purchaseOrder: PurchaseOrder
  id: UUID!
  createdAtUtc: DateTime!
  updatedAtUtc: DateTime
}

"A connection to a list of items."
type GoodsReceiptsConnection {
  "Information to aid in pagination."
  pageInfo: PageInfo!
  "A list of edges."
  edges: [GoodsReceiptsEdge!]
  "A flattened list of the nodes."
  nodes: [GoodsReceipt!]
}

"An edge in a connection."
type GoodsReceiptsEdge {
  "A cursor for use in pagination."
  cursor: String!
  "The item at the end of the edge."
  node: GoodsReceipt!
}

"Information about pagination in a connection."
type PageInfo {
  "Indicates whether more edges exist following the set defined by the clients arguments."
  hasNextPage: Boolean!
  "Indicates whether more edges exist prior the set defined by the clients arguments."
  hasPreviousPage: Boolean!
  "When paginating backwards, the cursor to continue."
  startCursor: String
  "When paginating forwards, the cursor to continue."
  endCursor: String
}

type ProcurementMutationPayloadOfPurchaseOrderDto {
  success: Boolean!
  data: PurchaseOrderDto
  error: String
}

type ProcurementMutationPayloadOfVendorDto {
  success: Boolean!
  data: VendorDto
  error: String
}

type Product {
  id: UUID!
}

"Represents a purchase order issued to a vendor."
type PurchaseOrder {
  vendorId: UUID!
  "The vendor for this purchase order (resolved via DataLoader)."
  vendor: Vendor @cost(weight: "10")
  "The line items for this purchase order (resolved via DataLoader)."
  lines: [PurchaseOrderLine!]! @cost(weight: "10")
  poNumber: String!
  orderDateUtc: DateTime!
  expectedDeliveryDateUtc: DateTime
  status: PurchaseOrderStatus!
  totalCost: Decimal!
  notes: String!
  goodsReceipts: [GoodsReceipt!]!
  id: UUID!
  createdAtUtc: DateTime!
  updatedAtUtc: DateTime
}

type PurchaseOrderDto {
  id: UUID!
  poNumber: String!
  vendorId: UUID!
  orderDateUtc: DateTime!
  expectedDeliveryDateUtc: DateTime
  status: PurchaseOrderStatus!
  totalCost: Decimal!
  notes: String!
  lines: [PurchaseOrderLineDto!]!
}

"Represents a line item in a purchase order."
type PurchaseOrderLine {
  "The product associated with this purchase order line (stitched from InventoryService)."
  product: Product @cost(weight: "10")
  purchaseOrderId: UUID!
  productId: UUID!
  sku: String!
  productName: String!
  quantityOrdered: Int!
  quantityReceived: Int!
  unitCost: Decimal!
  lineTotal: Decimal!
  purchaseOrder: PurchaseOrder
  id: UUID!
  createdAtUtc: DateTime!
  updatedAtUtc: DateTime
}

type PurchaseOrderLineDto {
  id: UUID!
  purchaseOrderId: UUID!
  productId: UUID!
  sku: String!
  productName: String!
  quantityOrdered: Int!
  quantityReceived: Int!
  unitCost: Decimal!
  lineTotal: Decimal!
}

"A connection to a list of items."
type PurchaseOrdersConnection {
  "Information to aid in pagination."
  pageInfo: PageInfo!
  "A list of edges."
  edges: [PurchaseOrdersEdge!]
  "A flattened list of the nodes."
  nodes: [PurchaseOrder!]
}

"An edge in a connection."
type PurchaseOrdersEdge {
  "A cursor for use in pagination."
  cursor: String!
  "The item at the end of the edge."
  node: PurchaseOrder!
}

type Vendor {
  vendorCode: String!
  name: String!
  contactEmail: String!
  phone: String!
  address: String!
  paymentTermsDays: Int!
  taxId: String!
  isActive: Boolean!
  purchaseOrders: [PurchaseOrder!]!
  id: UUID!
  createdAtUtc: DateTime!
  updatedAtUtc: DateTime
}

type VendorDto {
  id: UUID!
  vendorCode: String!
  name: String!
  contactEmail: String!
  phone: String!
  address: String!
  paymentTermsDays: Int!
  taxId: String!
  isActive: Boolean!
  createdAtUtc: DateTime!
}

"A connection to a list of items."
type VendorsConnection {
  "Information to aid in pagination."
  pageInfo: PageInfo!
  "A list of edges."
  edges: [VendorsEdge!]
  "A flattened list of the nodes."
  nodes: [Vendor!]
}

"An edge in a connection."
type VendorsEdge {
  "A cursor for use in pagination."
  cursor: String!
  "The item at the end of the edge."
  node: Vendor!
}

input BooleanOperationFilterInput {
  eq: Boolean @cost(weight: "10")
  neq: Boolean @cost(weight: "10")
}

input CreatePoLineInput {
  productId: UUID!
  sku: String!
  productName: String!
  quantityOrdered: Int!
  unitCost: Decimal!
}

input CreatePurchaseOrderInput {
  vendorId: UUID!
  expectedDeliveryDateUtc: DateTime
  notes: String!
  lines: [CreatePoLineInput!]!
}

input CreateVendorInput {
  name: String!
  contactEmail: String!
  phone: String!
  address: String!
  paymentTermsDays: Int!
  taxId: String!
}

input DateTimeOperationFilterInput {
  eq: DateTime @cost(weight: "10")
  neq: DateTime @cost(weight: "10")
  in: [DateTime] @cost(weight: "10")
  nin: [DateTime] @cost(weight: "10")
  gt: DateTime @cost(weight: "10")
  ngt: DateTime @cost(weight: "10")
  gte: DateTime @cost(weight: "10")
  ngte: DateTime @cost(weight: "10")
  lt: DateTime @cost(weight: "10")
  nlt: DateTime @cost(weight: "10")
  lte: DateTime @cost(weight: "10")
  nlte: DateTime @cost(weight: "10")
}

input DecimalOperationFilterInput {
  eq: Decimal @cost(weight: "10")
  neq: Decimal @cost(weight: "10")
  in: [Decimal] @cost(weight: "10")
  nin: [Decimal] @cost(weight: "10")
  gt: Decimal @cost(weight: "10")
  ngt: Decimal @cost(weight: "10")
  gte: Decimal @cost(weight: "10")
  ngte: Decimal @cost(weight: "10")
  lt: Decimal @cost(weight: "10")
  nlt: Decimal @cost(weight: "10")
  lte: Decimal @cost(weight: "10")
  nlte: Decimal @cost(weight: "10")
}

input GoodsReceiptFilterInput {
  and: [GoodsReceiptFilterInput!]
  or: [GoodsReceiptFilterInput!]
  purchaseOrderId: UuidOperationFilterInput
  receiptNumber: StringOperationFilterInput
  receivedDateUtc: DateTimeOperationFilterInput
  receivedBy: StringOperationFilterInput
  notes: StringOperationFilterInput
  purchaseOrder: PurchaseOrderFilterInput
  id: UuidOperationFilterInput
  createdAtUtc: DateTimeOperationFilterInput
  updatedAtUtc: DateTimeOperationFilterInput
}

input GoodsReceiptSortInput {
  purchaseOrderId: SortEnumType @cost(weight: "10")
  receiptNumber: SortEnumType @cost(weight: "10")
  receivedDateUtc: SortEnumType @cost(weight: "10")
  receivedBy: SortEnumType @cost(weight: "10")
  notes: SortEnumType @cost(weight: "10")
  purchaseOrder: PurchaseOrderSortInput @cost(weight: "10")
  id: SortEnumType @cost(weight: "10")
  createdAtUtc: SortEnumType @cost(weight: "10")
  updatedAtUtc: SortEnumType @cost(weight: "10")
}

input IntOperationFilterInput {
  eq: Int @cost(weight: "10")
  neq: Int @cost(weight: "10")
  in: [Int] @cost(weight: "10")
  nin: [Int] @cost(weight: "10")
  gt: Int @cost(weight: "10")
  ngt: Int @cost(weight: "10")
  gte: Int @cost(weight: "10")
  ngte: Int @cost(weight: "10")
  lt: Int @cost(weight: "10")
  nlt: Int @cost(weight: "10")
  lte: Int @cost(weight: "10")
  nlte: Int @cost(weight: "10")
}

input ListFilterInputTypeOfGoodsReceiptFilterInput {
  all: GoodsReceiptFilterInput @cost(weight: "10")
  none: GoodsReceiptFilterInput @cost(weight: "10")
  some: GoodsReceiptFilterInput @cost(weight: "10")
  any: Boolean @cost(weight: "10")
}

input ListFilterInputTypeOfPurchaseOrderFilterInput {
  all: PurchaseOrderFilterInput @cost(weight: "10")
  none: PurchaseOrderFilterInput @cost(weight: "10")
  some: PurchaseOrderFilterInput @cost(weight: "10")
  any: Boolean @cost(weight: "10")
}

input ListFilterInputTypeOfPurchaseOrderLineFilterInput {
  all: PurchaseOrderLineFilterInput @cost(weight: "10")
  none: PurchaseOrderLineFilterInput @cost(weight: "10")
  some: PurchaseOrderLineFilterInput @cost(weight: "10")
  any: Boolean @cost(weight: "10")
}

input PurchaseOrderFilterInput {
  and: [PurchaseOrderFilterInput!]
  or: [PurchaseOrderFilterInput!]
  poNumber: StringOperationFilterInput
  vendorId: UuidOperationFilterInput
  orderDateUtc: DateTimeOperationFilterInput
  expectedDeliveryDateUtc: DateTimeOperationFilterInput
  status: PurchaseOrderStatusOperationFilterInput
  totalCost: DecimalOperationFilterInput
  notes: StringOperationFilterInput
  vendor: VendorFilterInput
  lines: ListFilterInputTypeOfPurchaseOrderLineFilterInput
  goodsReceipts: ListFilterInputTypeOfGoodsReceiptFilterInput
  id: UuidOperationFilterInput
  createdAtUtc: DateTimeOperationFilterInput
  updatedAtUtc: DateTimeOperationFilterInput
}

input PurchaseOrderLineFilterInput {
  and: [PurchaseOrderLineFilterInput!]
  or: [PurchaseOrderLineFilterInput!]
  purchaseOrderId: UuidOperationFilterInput
  productId: UuidOperationFilterInput
  sku: StringOperationFilterInput
  productName: StringOperationFilterInput
  quantityOrdered: IntOperationFilterInput
  quantityReceived: IntOperationFilterInput
  unitCost: DecimalOperationFilterInput
  lineTotal: DecimalOperationFilterInput
  purchaseOrder: PurchaseOrderFilterInput
  id: UuidOperationFilterInput
  createdAtUtc: DateTimeOperationFilterInput
  updatedAtUtc: DateTimeOperationFilterInput
}

input PurchaseOrderSortInput {
  poNumber: SortEnumType @cost(weight: "10")
  vendorId: SortEnumType @cost(weight: "10")
  orderDateUtc: SortEnumType @cost(weight: "10")
  expectedDeliveryDateUtc: SortEnumType @cost(weight: "10")
  status: SortEnumType @cost(weight: "10")
  totalCost: SortEnumType @cost(weight: "10")
  notes: SortEnumType @cost(weight: "10")
  vendor: VendorSortInput @cost(weight: "10")
  id: SortEnumType @cost(weight: "10")
  createdAtUtc: SortEnumType @cost(weight: "10")
  updatedAtUtc: SortEnumType @cost(weight: "10")
}

input PurchaseOrderStatusOperationFilterInput {
  eq: PurchaseOrderStatus @cost(weight: "10")
  neq: PurchaseOrderStatus @cost(weight: "10")
  in: [PurchaseOrderStatus!] @cost(weight: "10")
  nin: [PurchaseOrderStatus!] @cost(weight: "10")
}

input StringOperationFilterInput {
  and: [StringOperationFilterInput!]
  or: [StringOperationFilterInput!]
  eq: String @cost(weight: "10")
  neq: String @cost(weight: "10")
  contains: String @cost(weight: "20")
  ncontains: String @cost(weight: "20")
  in: [String] @cost(weight: "10")
  nin: [String] @cost(weight: "10")
  startsWith: String @cost(weight: "20")
  nstartsWith: String @cost(weight: "20")
  endsWith: String @cost(weight: "20")
  nendsWith: String @cost(weight: "20")
}

input UuidOperationFilterInput {
  eq: UUID @cost(weight: "10")
  neq: UUID @cost(weight: "10")
  in: [UUID] @cost(weight: "10")
  nin: [UUID] @cost(weight: "10")
  gt: UUID @cost(weight: "10")
  ngt: UUID @cost(weight: "10")
  gte: UUID @cost(weight: "10")
  ngte: UUID @cost(weight: "10")
  lt: UUID @cost(weight: "10")
  nlt: UUID @cost(weight: "10")
  lte: UUID @cost(weight: "10")
  nlte: UUID @cost(weight: "10")
}

input VendorFilterInput {
  and: [VendorFilterInput!]
  or: [VendorFilterInput!]
  vendorCode: StringOperationFilterInput
  name: StringOperationFilterInput
  contactEmail: StringOperationFilterInput
  phone: StringOperationFilterInput
  address: StringOperationFilterInput
  paymentTermsDays: IntOperationFilterInput
  taxId: StringOperationFilterInput
  isActive: BooleanOperationFilterInput
  purchaseOrders: ListFilterInputTypeOfPurchaseOrderFilterInput
  id: UuidOperationFilterInput
  createdAtUtc: DateTimeOperationFilterInput
  updatedAtUtc: DateTimeOperationFilterInput
}

input VendorSortInput {
  vendorCode: SortEnumType @cost(weight: "10")
  name: SortEnumType @cost(weight: "10")
  contactEmail: SortEnumType @cost(weight: "10")
  phone: SortEnumType @cost(weight: "10")
  address: SortEnumType @cost(weight: "10")
  paymentTermsDays: SortEnumType @cost(weight: "10")
  taxId: SortEnumType @cost(weight: "10")
  isActive: SortEnumType @cost(weight: "10")
  id: SortEnumType @cost(weight: "10")
  createdAtUtc: SortEnumType @cost(weight: "10")
  updatedAtUtc: SortEnumType @cost(weight: "10")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum SortEnumType {
  ASC
  DESC
}

"The `DateTime` scalar type represents a date and time with time zone offset information."
scalar DateTime
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/date-time.html")

"The `Decimal` scalar type represents a decimal floating-point number with high precision."
scalar Decimal
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/decimal.html")

"The `UUID` scalar type represents a Universally Unique Identifier (UUID) as defined by RFC 9562."
scalar UUID
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/uuid.html")

"The purpose of the `cost` directive is to define a `weight` for GraphQL types, fields, and arguments. Static analysis can use these weights when calculating the overall cost of a query or response."
directive @cost(
  "The `weight` argument defines what value to add to the overall cost for every appearance, or possible appearance, of a type, field, argument, etc."
  weight: String!
) on
  | SCALAR
  | OBJECT
  | FIELD_DEFINITION
  | ARGUMENT_DEFINITION
  | ENUM
  | INPUT_FIELD_DEFINITION

"The purpose of the `@listSize` directive is to either inform the static analysis about the size of returned lists (if that information is statically available), or to point the analysis to where to find that information."
directive @listSize(
  "The `assumedSize` argument can be used to statically define the maximum length of a list returned by a field."
  assumedSize: Int
  "The `slicingArguments` argument can be used to define which of the field's arguments with numeric type are slicing arguments, so that their value determines the size of the list returned by that field. It may specify a list of multiple slicing arguments."
  slicingArguments: [String!]
  "The `slicingArgumentDefaultValue` argument can be used to define a default value for a slicing argument, which is used if the argument is not present in a query."
  slicingArgumentDefaultValue: Int
  "The `sizedFields` argument can be used to define that the value of the `assumedSize` argument or of a slicing argument does not affect the size of a list returned by a field itself, but that of a list returned by one of its sub-fields."
  sizedFields: [String!]
  "The `requireOneSlicingArgument` argument can be used to inform the static analysis that it should expect that exactly one of the defined slicing arguments is present in a query. If that is not the case (i.e., if none or multiple slicing arguments are present), the static analysis may throw an error."
  requireOneSlicingArgument: Boolean = true
) on FIELD_DEFINITION

"""
The @lookup directive is used within a source schema to specify output fields
that can be used by the distributed GraphQL executor to resolve an entity by
a stable key.
"""
directive @lookup on FIELD_DEFINITION