schema {
  query: Query
  mutation: Mutation
}

type Query {
  customers(
    "Returns the first _n_ elements from the list."
    first: Int
    "Returns the elements in the list that come after the specified cursor."
    after: String
    "Returns the last _n_ elements from the list."
    last: Int
    "Returns the elements in the list that come before the specified cursor."
    before: String
    where: CustomerFilterInput @cost(weight: "10")
    order: [CustomerSortInput!] @cost(weight: "10")
  ): CustomersConnection
    @listSize(
      assumedSize: 50
      slicingArguments: ["first", "last"]
      slicingArgumentDefaultValue: 10
      sizedFields: ["edges", "nodes"]
      requireOneSlicingArgument: false
    )
    @cost(weight: "10")
  customerById(id: UUID!): Customer @lookup @cost(weight: "10")
  salesOrders(
    "Returns the first _n_ elements from the list."
    first: Int
    "Returns the elements in the list that come after the specified cursor."
    after: String
    "Returns the last _n_ elements from the list."
    last: Int
    "Returns the elements in the list that come before the specified cursor."
    before: String
    where: SalesOrderFilterInput @cost(weight: "10")
    order: [SalesOrderSortInput!] @cost(weight: "10")
  ): SalesOrdersConnection
    @listSize(
      assumedSize: 50
      slicingArguments: ["first", "last"]
      slicingArgumentDefaultValue: 10
      sizedFields: ["edges", "nodes"]
      requireOneSlicingArgument: false
    )
    @cost(weight: "10")
  shipments(
    "Returns the first _n_ elements from the list."
    first: Int
    "Returns the elements in the list that come after the specified cursor."
    after: String
    "Returns the last _n_ elements from the list."
    last: Int
    "Returns the elements in the list that come before the specified cursor."
    before: String
    where: ShipmentFilterInput @cost(weight: "10")
    order: [ShipmentSortInput!] @cost(weight: "10")
  ): ShipmentsConnection
    @listSize(
      assumedSize: 50
      slicingArguments: ["first", "last"]
      slicingArgumentDefaultValue: 10
      sizedFields: ["edges", "nodes"]
      requireOneSlicingArgument: false
    )
    @cost(weight: "10")
}

type Mutation {
  createCustomer(input: CreateCustomerInput!): SalesMutationPayloadOfCustomerDto!
    @cost(weight: "10")
  createSalesOrder(input: CreateSalesOrderInput!): SalesMutationPayloadOfSalesOrderDto!
    @cost(weight: "10")
}

type Customer {
  customerNumber: String!
  name: String!
  email: String!
  phone: String!
  billingAddress: String!
  shippingAddress: String!
  creditLimit: Decimal!
  isActive: Boolean!
  salesOrders: [SalesOrder!]!
  id: UUID!
  createdAtUtc: DateTime!
  updatedAtUtc: DateTime
}

type CustomerDto {
  id: UUID!
  customerNumber: String!
  name: String!
  email: String!
  phone: String!
  billingAddress: String!
  shippingAddress: String!
  creditLimit: Decimal!
  isActive: Boolean!
  createdAtUtc: DateTime!
}

"A connection to a list of items."
type CustomersConnection {
  "Information to aid in pagination."
  pageInfo: PageInfo!
  "A list of edges."
  edges: [CustomersEdge!]
  "A flattened list of the nodes."
  nodes: [Customer!]
}

"An edge in a connection."
type CustomersEdge {
  "A cursor for use in pagination."
  cursor: String!
  "The item at the end of the edge."
  node: Customer!
}

"Information about pagination in a connection."
type PageInfo {
  "Indicates whether more edges exist following the set defined by the clients arguments."
  hasNextPage: Boolean!
  "Indicates whether more edges exist prior the set defined by the clients arguments."
  hasPreviousPage: Boolean!
  "When paginating backwards, the cursor to continue."
  startCursor: String
  "When paginating forwards, the cursor to continue."
  endCursor: String
}

type Product {
  id: UUID!
}

type SalesMutationPayloadOfCustomerDto {
  success: Boolean!
  data: CustomerDto
  error: String
}

type SalesMutationPayloadOfSalesOrderDto {
  success: Boolean!
  data: SalesOrderDto
  error: String
}

"Represents a customer sales order with line items."
type SalesOrder {
  customerId: UUID!
  "The customer who placed the order (resolved via DataLoader)."
  customer: Customer @cost(weight: "10")
  "The line items for this sales order (resolved via DataLoader)."
  lines: [SalesOrderLine!]! @cost(weight: "10")
  orderNumber: String!
  orderDateUtc: DateTime!
  status: OrderStatus!
  totalAmount: Decimal!
  notes: String!
  shipment: Shipment
  id: UUID!
  createdAtUtc: DateTime!
  updatedAtUtc: DateTime
}

type SalesOrderDto {
  id: UUID!
  orderNumber: String!
  customerId: UUID!
  orderDateUtc: DateTime!
  status: OrderStatus!
  totalAmount: Decimal!
  notes: String!
  lines: [SalesOrderLineDto!]!
}

"Represents a line item in a sales order."
type SalesOrderLine {
  "The product associated with this sales order line (stitched from InventoryService)."
  product: Product @cost(weight: "10")
  salesOrderId: UUID!
  productId: UUID!
  sku: String!
  productName: String!
  quantity: Int!
  unitPrice: Decimal!
  discountPercentage: Decimal!
  lineTotal: Decimal!
  salesOrder: SalesOrder
  id: UUID!
  createdAtUtc: DateTime!
  updatedAtUtc: DateTime
}

type SalesOrderLineDto {
  id: UUID!
  salesOrderId: UUID!
  productId: UUID!
  sku: String!
  productName: String!
  quantity: Int!
  unitPrice: Decimal!
  discountPercentage: Decimal!
  lineTotal: Decimal!
}

"A connection to a list of items."
type SalesOrdersConnection {
  "Information to aid in pagination."
  pageInfo: PageInfo!
  "A list of edges."
  edges: [SalesOrdersEdge!]
  "A flattened list of the nodes."
  nodes: [SalesOrder!]
}

"An edge in a connection."
type SalesOrdersEdge {
  "A cursor for use in pagination."
  cursor: String!
  "The item at the end of the edge."
  node: SalesOrder!
}

type Shipment {
  salesOrderId: UUID!
  trackingNumber: String!
  carrier: String!
  status: ShipmentStatus!
  shippedAtUtc: DateTime
  deliveredAtUtc: DateTime
  salesOrder: SalesOrder
  id: UUID!
  createdAtUtc: DateTime!
  updatedAtUtc: DateTime
}

"A connection to a list of items."
type ShipmentsConnection {
  "Information to aid in pagination."
  pageInfo: PageInfo!
  "A list of edges."
  edges: [ShipmentsEdge!]
  "A flattened list of the nodes."
  nodes: [Shipment!]
}

"An edge in a connection."
type ShipmentsEdge {
  "A cursor for use in pagination."
  cursor: String!
  "The item at the end of the edge."
  node: Shipment!
}

input BooleanOperationFilterInput {
  eq: Boolean @cost(weight: "10")
  neq: Boolean @cost(weight: "10")
}

input CreateCustomerInput {
  name: String!
  email: String!
  phone: String!
  billingAddress: String!
  shippingAddress: String!
  creditLimit: Decimal!
}

input CreateSalesOrderInput {
  customerId: UUID!
  notes: String!
  lines: [CreateSalesOrderLineInput!]!
}

input CreateSalesOrderLineInput {
  productId: UUID!
  sku: String!
  productName: String!
  quantity: Int!
  unitPrice: Decimal!
  discountPercentage: Decimal!
}

input CustomerFilterInput {
  and: [CustomerFilterInput!]
  or: [CustomerFilterInput!]
  customerNumber: StringOperationFilterInput
  name: StringOperationFilterInput
  email: StringOperationFilterInput
  phone: StringOperationFilterInput
  billingAddress: StringOperationFilterInput
  shippingAddress: StringOperationFilterInput
  creditLimit: DecimalOperationFilterInput
  isActive: BooleanOperationFilterInput
  salesOrders: ListFilterInputTypeOfSalesOrderFilterInput
  id: UuidOperationFilterInput
  createdAtUtc: DateTimeOperationFilterInput
  updatedAtUtc: DateTimeOperationFilterInput
}

input CustomerSortInput {
  customerNumber: SortEnumType @cost(weight: "10")
  name: SortEnumType @cost(weight: "10")
  email: SortEnumType @cost(weight: "10")
  phone: SortEnumType @cost(weight: "10")
  billingAddress: SortEnumType @cost(weight: "10")
  shippingAddress: SortEnumType @cost(weight: "10")
  creditLimit: SortEnumType @cost(weight: "10")
  isActive: SortEnumType @cost(weight: "10")
  id: SortEnumType @cost(weight: "10")
  createdAtUtc: SortEnumType @cost(weight: "10")
  updatedAtUtc: SortEnumType @cost(weight: "10")
}

input DateTimeOperationFilterInput {
  eq: DateTime @cost(weight: "10")
  neq: DateTime @cost(weight: "10")
  in: [DateTime] @cost(weight: "10")
  nin: [DateTime] @cost(weight: "10")
  gt: DateTime @cost(weight: "10")
  ngt: DateTime @cost(weight: "10")
  gte: DateTime @cost(weight: "10")
  ngte: DateTime @cost(weight: "10")
  lt: DateTime @cost(weight: "10")
  nlt: DateTime @cost(weight: "10")
  lte: DateTime @cost(weight: "10")
  nlte: DateTime @cost(weight: "10")
}

input DecimalOperationFilterInput {
  eq: Decimal @cost(weight: "10")
  neq: Decimal @cost(weight: "10")
  in: [Decimal] @cost(weight: "10")
  nin: [Decimal] @cost(weight: "10")
  gt: Decimal @cost(weight: "10")
  ngt: Decimal @cost(weight: "10")
  gte: Decimal @cost(weight: "10")
  ngte: Decimal @cost(weight: "10")
  lt: Decimal @cost(weight: "10")
  nlt: Decimal @cost(weight: "10")
  lte: Decimal @cost(weight: "10")
  nlte: Decimal @cost(weight: "10")
}

input IntOperationFilterInput {
  eq: Int @cost(weight: "10")
  neq: Int @cost(weight: "10")
  in: [Int] @cost(weight: "10")
  nin: [Int] @cost(weight: "10")
  gt: Int @cost(weight: "10")
  ngt: Int @cost(weight: "10")
  gte: Int @cost(weight: "10")
  ngte: Int @cost(weight: "10")
  lt: Int @cost(weight: "10")
  nlt: Int @cost(weight: "10")
  lte: Int @cost(weight: "10")
  nlte: Int @cost(weight: "10")
}

input ListFilterInputTypeOfSalesOrderFilterInput {
  all: SalesOrderFilterInput @cost(weight: "10")
  none: SalesOrderFilterInput @cost(weight: "10")
  some: SalesOrderFilterInput @cost(weight: "10")
  any: Boolean @cost(weight: "10")
}

input ListFilterInputTypeOfSalesOrderLineFilterInput {
  all: SalesOrderLineFilterInput @cost(weight: "10")
  none: SalesOrderLineFilterInput @cost(weight: "10")
  some: SalesOrderLineFilterInput @cost(weight: "10")
  any: Boolean @cost(weight: "10")
}

input OrderStatusOperationFilterInput {
  eq: OrderStatus @cost(weight: "10")
  neq: OrderStatus @cost(weight: "10")
  in: [OrderStatus!] @cost(weight: "10")
  nin: [OrderStatus!] @cost(weight: "10")
}

input SalesOrderFilterInput {
  and: [SalesOrderFilterInput!]
  or: [SalesOrderFilterInput!]
  orderNumber: StringOperationFilterInput
  customerId: UuidOperationFilterInput
  orderDateUtc: DateTimeOperationFilterInput
  status: OrderStatusOperationFilterInput
  totalAmount: DecimalOperationFilterInput
  notes: StringOperationFilterInput
  customer: CustomerFilterInput
  lines: ListFilterInputTypeOfSalesOrderLineFilterInput
  shipment: ShipmentFilterInput
  id: UuidOperationFilterInput
  createdAtUtc: DateTimeOperationFilterInput
  updatedAtUtc: DateTimeOperationFilterInput
}

input SalesOrderLineFilterInput {
  and: [SalesOrderLineFilterInput!]
  or: [SalesOrderLineFilterInput!]
  salesOrderId: UuidOperationFilterInput
  productId: UuidOperationFilterInput
  sku: StringOperationFilterInput
  productName: StringOperationFilterInput
  quantity: IntOperationFilterInput
  unitPrice: DecimalOperationFilterInput
  discountPercentage: DecimalOperationFilterInput
  lineTotal: DecimalOperationFilterInput
  salesOrder: SalesOrderFilterInput
  id: UuidOperationFilterInput
  createdAtUtc: DateTimeOperationFilterInput
  updatedAtUtc: DateTimeOperationFilterInput
}

input SalesOrderSortInput {
  orderNumber: SortEnumType @cost(weight: "10")
  customerId: SortEnumType @cost(weight: "10")
  orderDateUtc: SortEnumType @cost(weight: "10")
  status: SortEnumType @cost(weight: "10")
  totalAmount: SortEnumType @cost(weight: "10")
  notes: SortEnumType @cost(weight: "10")
  customer: CustomerSortInput @cost(weight: "10")
  shipment: ShipmentSortInput @cost(weight: "10")
  id: SortEnumType @cost(weight: "10")
  createdAtUtc: SortEnumType @cost(weight: "10")
  updatedAtUtc: SortEnumType @cost(weight: "10")
}

input ShipmentFilterInput {
  and: [ShipmentFilterInput!]
  or: [ShipmentFilterInput!]
  salesOrderId: UuidOperationFilterInput
  trackingNumber: StringOperationFilterInput
  carrier: StringOperationFilterInput
  status: ShipmentStatusOperationFilterInput
  shippedAtUtc: DateTimeOperationFilterInput
  deliveredAtUtc: DateTimeOperationFilterInput
  salesOrder: SalesOrderFilterInput
  id: UuidOperationFilterInput
  createdAtUtc: DateTimeOperationFilterInput
  updatedAtUtc: DateTimeOperationFilterInput
}

input ShipmentSortInput {
  salesOrderId: SortEnumType @cost(weight: "10")
  trackingNumber: SortEnumType @cost(weight: "10")
  carrier: SortEnumType @cost(weight: "10")
  status: SortEnumType @cost(weight: "10")
  shippedAtUtc: SortEnumType @cost(weight: "10")
  deliveredAtUtc: SortEnumType @cost(weight: "10")
  salesOrder: SalesOrderSortInput @cost(weight: "10")
  id: SortEnumType @cost(weight: "10")
  createdAtUtc: SortEnumType @cost(weight: "10")
  updatedAtUtc: SortEnumType @cost(weight: "10")
}

input ShipmentStatusOperationFilterInput {
  eq: ShipmentStatus @cost(weight: "10")
  neq: ShipmentStatus @cost(weight: "10")
  in: [ShipmentStatus!] @cost(weight: "10")
  nin: [ShipmentStatus!] @cost(weight: "10")
}

input StringOperationFilterInput {
  and: [StringOperationFilterInput!]
  or: [StringOperationFilterInput!]
  eq: String @cost(weight: "10")
  neq: String @cost(weight: "10")
  contains: String @cost(weight: "20")
  ncontains: String @cost(weight: "20")
  in: [String] @cost(weight: "10")
  nin: [String] @cost(weight: "10")
  startsWith: String @cost(weight: "20")
  nstartsWith: String @cost(weight: "20")
  endsWith: String @cost(weight: "20")
  nendsWith: String @cost(weight: "20")
}

input UuidOperationFilterInput {
  eq: UUID @cost(weight: "10")
  neq: UUID @cost(weight: "10")
  in: [UUID] @cost(weight: "10")
  nin: [UUID] @cost(weight: "10")
  gt: UUID @cost(weight: "10")
  ngt: UUID @cost(weight: "10")
  gte: UUID @cost(weight: "10")
  ngte: UUID @cost(weight: "10")
  lt: UUID @cost(weight: "10")
  nlt: UUID @cost(weight: "10")
  lte: UUID @cost(weight: "10")
  nlte: UUID @cost(weight: "10")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum SortEnumType {
  ASC
  DESC
}

"The `DateTime` scalar type represents a date and time with time zone offset information."
scalar DateTime
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/date-time.html")

"The `Decimal` scalar type represents a decimal floating-point number with high precision."
scalar Decimal
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/decimal.html")

"The `UUID` scalar type represents a Universally Unique Identifier (UUID) as defined by RFC 9562."
scalar UUID
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/uuid.html")

"The purpose of the `cost` directive is to define a `weight` for GraphQL types, fields, and arguments. Static analysis can use these weights when calculating the overall cost of a query or response."
directive @cost(
  "The `weight` argument defines what value to add to the overall cost for every appearance, or possible appearance, of a type, field, argument, etc."
  weight: String!
) on
  | SCALAR
  | OBJECT
  | FIELD_DEFINITION
  | ARGUMENT_DEFINITION
  | ENUM
  | INPUT_FIELD_DEFINITION

"The purpose of the `@listSize` directive is to either inform the static analysis about the size of returned lists (if that information is statically available), or to point the analysis to where to find that information."
directive @listSize(
  "The `assumedSize` argument can be used to statically define the maximum length of a list returned by a field."
  assumedSize: Int
  "The `slicingArguments` argument can be used to define which of the field's arguments with numeric type are slicing arguments, so that their value determines the size of the list returned by that field. It may specify a list of multiple slicing arguments."
  slicingArguments: [String!]
  "The `slicingArgumentDefaultValue` argument can be used to define a default value for a slicing argument, which is used if the argument is not present in a query."
  slicingArgumentDefaultValue: Int
  "The `sizedFields` argument can be used to define that the value of the `assumedSize` argument or of a slicing argument does not affect the size of a list returned by a field itself, but that of a list returned by one of its sub-fields."
  sizedFields: [String!]
  "The `requireOneSlicingArgument` argument can be used to inform the static analysis that it should expect that exactly one of the defined slicing arguments is present in a query. If that is not the case (i.e., if none or multiple slicing arguments are present), the static analysis may throw an error."
  requireOneSlicingArgument: Boolean = true
) on FIELD_DEFINITION

"""
The @lookup directive is used within a source schema to specify output fields
that can be used by the distributed GraphQL executor to resolve an entity by
a stable key.
"""
directive @lookup on FIELD_DEFINITION